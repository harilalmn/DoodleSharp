<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>img\logo.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DoodleSharp</AssemblyName>
    <RootNamespace>DoodleSharp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude sibling project folders from compilation -->
    <Compile Remove="Tests\**" />
    <Compile Remove="Bench\**" />
    <Compile Remove="C2VGeometry\**" />
    <Compile Remove="RegionSample\**" />
    <Compile Remove="Sample Projects\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="C2VGeometry\C2VGeometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <PackageReference Include="NuGet.Protocol" Version="6.13.2" />
    <PackageReference Include="NuGet.Packaging" Version="6.13.2" />
    <PackageReference Include="PDFsharp" Version="6.1.0" />

    <!-- Optional GPU backend. Managed-only assemblies (no runtimes/native folder), so they land
         flat in the build output and each needs one explicit installer line. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Editor\CSharpHighlighting.xshd" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="img\logo.ico" />
    <!-- img/logo.png is the README lockup only. The app draws its mark from Assets/Logo.xaml, so
         embedding the bitmap would put it in the assembly for nothing. -->
    <Resource Include="img\folder.png" />
    <Resource Include="img\file.png" />
  </ItemGroup>

</Project>
