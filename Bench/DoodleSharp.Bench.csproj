<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Benchmark harness for the render pipeline. Built by CI so it cannot rot, run on demand, and
    deliberately NOT listed in installer.iss — it is a development tool, not part of the product.

    UseWPF because RenderCanvas is a FrameworkElement and the legacy backend measures WPF's own
    tessellation and composition cost; there is no way to measure that honestly without WPF present.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DoodleSharp.Bench</AssemblyName>
    <RootNamespace>DoodleSharp.Bench</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoodleSharp.csproj" />
    <ProjectReference Include="..\C2VGeometry\C2VGeometry.csproj" />
  </ItemGroup>

</Project>
