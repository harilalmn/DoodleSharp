<UserControl x:Class="DoodleSharp.GlobalParametersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource SecondaryBackgroundBrush}"
             d:DesignHeight="600" d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="ParamName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ParamBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="RangeBox" TargetType="TextBox" BasedOn="{StaticResource ParamBox}">
            <Setter Property="Width" Value="44" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Slider range (panel only — never written to your code)" />
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header Bar  -->
        <Border Grid.Row="0"
                Padding="10,6"
                Background="{StaticResource SecondaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrush}"
                           Text="GLOBAL PARAMETERS"
                           VerticalAlignment="Center" />
                <Button x:Name="ResetAllButton"
                        Grid.Column="1"
                        Content="Reset"
                        Padding="8,2"
                        FontSize="10"
                        Click="ResetAllButton_Click"
                        ToolTip="Restore every parameter to the value declared in code"
                        Background="{StaticResource BackgroundBrush}"
                        Foreground="{StaticResource ForegroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" />
            </Grid>
        </Border>

        <!--  Parameter rows  -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="10,4">
            <StackPanel x:Name="RowsPanel">
                <TextBlock x:Name="EmptyMessage"
                           Foreground="{StaticResource MutedForegroundBrush}"
                           FontSize="11"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Text="No global parameters declared.&#x0a;&#x0a;Add one in your code, then run:&#x0a;&#x0a;GlobalParameters.Set&lt;double&gt;(&quot;String Length&quot;, 10, min: 0, max: 50);" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
